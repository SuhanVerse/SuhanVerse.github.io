{
  "name": "suhanverse-portfolio",
  "version": "1.1.0",
  "description": "Personal portfolio website of Suhan Khadka showcasing embedded systems, AI/ML, and full-stack projects.",
  "author": "Suhan Khadka",
  "license": "Apache-2.0",
  "homepage": "https://suhanverse.github.io",
  "scripts": {
    "dev": "parcel src/index.html --open",
    "build": "parcel build src/index.html --dist-dir docs --no-source-maps",
    "clean": "rm -rf .parcel-cache docs",
    "lint": "node --check src/js/index.js && node scripts/check-site.mjs",
    "preview": "npx serve docs",
    "deploy": "npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@babel/preset-env": "^7.22.5",
    "@parcel/packager-raw-url": "^2.15.4",
    "@parcel/transformer-jsonld": "^2.15.4",
    "@parcel/transformer-sass": "^2.15.4",
    "cssnano": "^6.0.1",
    "imagemin": "^9.0.1",
    "imagemin-jpegtran": "^5.0.2",
    "imagemin-mozjpeg": "^7.0.0",
    "imagemin-optipng": "^5.2.1",
    "imagemin-pngquant": "^5.0.1",
    "imagemin-webp": "^8.0.0",
    "parcel": "^2.15.4",
    "sass": "^1.69.0"
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "maintained node versions"
  ]
}
